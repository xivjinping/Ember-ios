<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for JIT. Lets a debugger attach, which sets CS_DEBUGGED and
         makes unsigned executable pages legal. Present on every development-
         signed build; absent from distribution/enterprise-signed ones. -->
    <key>get-task-allow</key>
    <true/>

    <!-- Optional. Raises the per-app memory limit on supported devices: useful
         headroom for 3x and 4.5x internal resolutions. Must be enabled on the
         App ID; if your provisioning profile lacks it, delete this key. -->
    <key>com.apple.developer.kernel.increased-memory-limit</key>
    <true/>
</dict>
</plist>
